/**index.wxss**/
page {
  height: 100vh;
  display: flex;
  flex-direction: column;
}

.home-page {
  width: 100%;
  height: 100vh;
}

.page-bg {
  width: 100%;
  height: 100%;
}

.home-modal {
  position: fixed;
  top: 0px;
  left: 0px;
  width: 100%;
  height: 100%;
  background: linear-gradient(to bottom, transparent 0%, var(--gray3) 40%, var(--gray1) 100%);
}

.home-menu {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-wrap: wrap;
  width: 540rpx;
  gap: 40rpx;
}

.menu-item {
  width: 250rpx;
  height: 250rpx;
  line-height: 250rpx;
  text-align: center;
  background: linear-gradient(to bottom, rgba(255, 255, 255, 0.1), white);
  letter-spacing: 4rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0rpx 10rpx 20rpx 0rpx rgba(0, 0, 0, 0.15);
  border-radius: 20rpx;
  letter-spacing: 10rpx;
  border-bottom: 4px solid var(--gray2);
}