/* pages/menu/index.wxss */
.menu-page {
  background-color: #f5f5f5;
  width: 100%;
  height: 100vh;
}

.menu-header {
  box-shadow: 0rpx 10rpx 10rpx 0rpx rgba(0, 0, 0, 0.1);
}

.header-bg {
  width: 100%;
  height: 400rpx;
  position: relative;
}



.menu-body {
  margin-top: 20rpx;
  display: flex;
  height: calc(100vh - 420rpx);
}

.sider-menu {
  width: 200rpx;
}

.menu-item {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  position: relative;
}

.menu-item::before {
  content: "";
  position: absolute;
  top: 0;
  left: -20rpx;
  width: 10rpx;
  height: 100%;
  background-color: var(--main-color);
  transition: all .25s ease-in;
}

.menu-item.active {
  position: relative;
  background: linear-gradient(to right, var(--gray3), var(--gray2));
  font-weight: bold
}

.menu-item.active::before {
  transform: translateX(20rpx);
}

.class-menu {
  width: calc(100% - 220rpx);

}

.class-menu_item {
  border-radius: 20rpx;
  background-color: white;
  margin-bottom: 20rpx;
  position: relative;
}

.class-menu_logo {
  width: 100%;
  height: 120rpx;
  border-top-left-radius: 20rpx;
  border-top-right-radius: 20rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

.header-label {
  font-weight: bold;
}

.header-desc {
  font-size: 22rpx;
  color: var(--sub-text-color);
  margin-top: 10rpx;
}

.class-menu {
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
  /*兼容 iOS<11.2 */
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.class-menu_body {
  padding: 40rpx 20rpx;
  box-sizing: border-box;
}

.class-menu_it {
  display: flex;
  margin-top: 40rpx;
}

.class-menu_not {
  height: 150rpx;
  line-height: 150rpx;
  width: 100%;
  text-align: center;
  font-size: 24rpx;
  color: var(--sub-text-color)
}

.class-item_img {
  width: 150rpx;
  height: 150rpx;
  border-radius: 100%;
  margin-right: 20rpx;
}

.class-item_body {
  width: calc(100% - 170rpx);
}

.class-item_label {
  display: flex;
}

.class-tags {
  display: flex;
  align-items: center;
}

.class-tag_item {
  background: linear-gradient(to right, var(--tag-bg-color2), var(--tag-bg-color1));
  font-size: 20rpx;
  color: var(--tag-color);
  padding: 2rpx 8rpx;
  box-sizing: border-box;
  margin-left: 10rpx;
}

.class-item_desc {
  color: var(--sub-text-color);
  font-size: 20rpx;
  margin-top: 8rpx;
}

.class-item_bottom {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
  width: 100%;
  justify-content: space-between;
}

.bottom-price {}

.current-price {
  color: var(--price-color);
  display: flex;
  align-items: center;
}

.current-price_value {
  font-weight: bold;
}

.original-price {
  font-size: 20rpx;
  color: var(--sub-text-color);
  text-decoration: line-through;
}

.price-unit {
  font-size: 20rpx;
}

.class-bottom_controls {
  position: relative;
  width: 50rpx;
  height: 50rpx;
}

.menu-add_icon {
  width: 50rpx;
  height: 50rpx;
  position: absolute;
  z-index: 9;
  background-color: white;
}

.animate-box {
  position: fixed;
  right: 40rpx;
  z-index: 11;
}

.animate-item {
  position: absolute;
  top: 7rpx;
  right: 7rpx;
  width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  background-color: var(--main-color);
  border-radius: 100%;

  color: white;
  text-align: center;
  font-size: 24rpx;
}

@keyframes toTop {
  to {
    /* transform: translateY(800px); */
    top: 100vh;
  }
}

@keyframes toLeft {
  to {
    /* transform: translateX(-600rpx); */
    right: 85vw;
  }
}

.animate-box.start {
  animation: toTop 0.75s cubic-bezier(0.175, -0.465, 0.355, 0.090) forwards;
}

.animate-item.start {
  animation: toLeft 0.75s ease forwards;
}